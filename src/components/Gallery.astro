---
// Full-width photo grid with a click-to-enlarge lightbox, as on the WordPress
// home page (which used masonry + fancybox). Photos live in public/images/gallery/.
interface Props { photos: { src: string; focus?: string }[]; label?: string }
const { photos, label = 'Photos from past CHIL conferences' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="gallery" role="list" aria-label={label}>
  {photos.map((p, i) => (
    <a class="gallery-item" role="listitem" href={`${base}${p.src}`} data-index={i} aria-label={`Open photo ${i + 1} of ${photos.length}`}>
      <img src={`${base}${p.src}`} alt="" loading="lazy" width="1400" height="933" style={p.focus && `object-position: ${p.focus}`} />
    </a>
  ))}
</div>

<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
  <img class="lightbox-img" alt="" />
  <button class="lightbox-btn lightbox-close" type="button" aria-label="Close">×</button>
  <button class="lightbox-btn lightbox-prev" type="button" aria-label="Previous photo">‹</button>
  <button class="lightbox-btn lightbox-next" type="button" aria-label="Next photo">›</button>
  <p class="lightbox-count" aria-live="polite"></p>
</dialog>

<script>
  const items = [...document.querySelectorAll<HTMLAnchorElement>('.gallery-item')];
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
  const count = dialog?.querySelector('.lightbox-count');
  let current = 0;

  function show(i: number) {
    if (!dialog || !img) return;
    current = (i + items.length) % items.length;
    img.src = items[current].href;
    if (count) count.textContent = `${current + 1} / ${items.length}`;
    if (!dialog.open) dialog.showModal();
  }

  items.forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
    })
  );
  dialog?.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
  dialog?.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));
  // Click on the backdrop (outside the photo and buttons) closes.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
